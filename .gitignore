target/
node_modules/
dist/
build/
.env
.env.*
!.env.example

# JS lockfiles are not committed; Cargo.lock IS committed because this is a
# binary crate and CI resolves transitive deps without it (e.g. time/cookie
# version skew breaks the build).
pnpm-lock.yaml
package-lock.json
yarn.lock

# Per-machine engine state (written by `iii worker add` + engine runtime)
config.yaml
iii.lock
data/

# Engine runtime drops fetched skill bundles under skills/; our own
# desktop skill bundle stays committed.
skills/*
!skills/iii-desktop/
!skills/iii-desktop/**

# TypeScript build cache
*.tsbuildinfo

*.log
.DS_Store
.idea/
.vscode/
*.iml

src-tauri/gen/
src-tauri/target/
src-tauri/WixTools/

web/dist/
web/.vite/

.claude/
CLAUDE.md
.cursorrules
.aider*
.gstack/
