{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities granted to the main desktop window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "shell:default",
    "dialog:default",
    "deep-link:default"
  ]
}
